# Защита от DDoS начинается ДО приложения: ограничения nginx + (желательно) CDN/WAF (Cloudflare и т.п.)
limit_req_zone  $binary_remote_addr zone=qc_api:10m rate=10r/s;
limit_req_zone  $binary_remote_addr zone=qc_login:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=qc_conn:10m;

server {
    listen 443 ssl http2;
    server_name coffee.example.com;
    ssl_certificate     /etc/letsencrypt/live/coffee.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coffee.example.com/privkey.pem;

    client_max_body_size 3m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    limit_conn qc_conn 40;

    location /api/auth/ {
        limit_req zone=qc_login burst=6 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/qc-proxy.conf;
    }
    location / {
        limit_req zone=qc_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/qc-proxy.conf;
    }
}
# /etc/nginx/qc-proxy.conf:
#   proxy_set_header Host $host;
#   proxy_set_header X-Forwarded-For $remote_addr;   # ПЕРЕЗАПИСЫВАЕМ, чтобы клиент не мог подделать IP
#   proxy_read_timeout 30s;
# И в .env: QC_TRUST_PROXY=1  QC_HTTPS=1  QC_HOST=127.0.0.1
